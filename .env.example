# FundiConnect example environment variables

# Local development Postgres (use a test DB or keep empty to rely on test mocks)
DATABASE_URL=postgres://mock_user:mock_password@localhost:5432/fundiconnect_dev

# GEMINI_API_KEY: Required for Gemini AI calls (set only on server-side deployments)
GEMINI_API_KEY=""

# Main Google Maps API key for the Mesh map.
# The server reads GOOGLE_MAPS_API_KEY and exposes it to the browser through /api/config/maps.
GOOGLE_MAPS_API_KEY=

# Legacy Vite/browser key. Prefer GOOGLE_MAPS_API_KEY above.
VITE_GOOGLE_MAPS_API_KEY=

# Application base URL (used for callbacks)
APP_URL="http://localhost:3000"
JWKS_URL=

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# Safaricom Daraja M-Pesa API Settings (Sandbox defaults)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your_sandbox_consumer_key"
MPESA_CONSUMER_SECRET="your_sandbox_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your_sandbox_passkey"

# Africa's Talking API (USSD & SMS Gateway Sandbox)
AT_USERNAME="sandbox"
AT_API_KEY="mock_at_api_key"

# AWS S3 Storage for Artisan Portfolios (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
S3_BUCKET=

# Curated Free & Open-Source Testing Integrations (no keys required)
# Weather Forecasting (Local Nairobi lookup)
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast?latitude=-1.29&longitude=36.82&hourly=temperature_2m"

# Finance & Exchange Rate Conversion (M-Pesa Multi-Currency support)
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/USD"

# Geocoding & Addresses (Nairobi maps representation)
NOMINATIM_GEOCODING_API_URL="https://nominatim.openstreetmap.org/search?q=Nairobi&format=json"

# Avatars & Placeholder Media for Artisan Portfolios
DICEBEAR_AVATARS_API_URL="https://api.dicebear.com/7.x/avataaars/svg?seed=example"

# Optional public APIs for testing
DOG_CEO_API_URL="https://dog.ceo/api/breeds/image/random"
OPEN_LIBRARY_BOOK_API="https://openlibrary.org/api/books?bibkeys=ISBN:0451526538&format=json"
DISEASE_SH_API="https://disease.sh/v3/covid-19/all"

# Runtime flags
# Local development can leave this as 0. Vercel automatically sets VERCEL=1
# in production, and server.ts uses that to select @neondatabase/serverless.
VERCEL=0

# Vercel production checklist:
# - Set DATABASE_URL in Vercel Project Settings to your Neon pooled connection string.
# - Set APP_URL to your production Vercel URL after the first deploy.

# Notes:
# - Do NOT commit real secrets. Use .env for local development and deploy secrets in your CI/CD.
# - For tests we provide mocks in src/tests/setup.ts to avoid needing a running Postgres.

